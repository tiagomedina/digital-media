# Copie para .env e preencha
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_ENCRYPTION_KEY=troque-esta-chave-com-32-chars-min-123

# LLM via OpenCode Go (OpenAI-compatible)
# Base oficial: https://opencode.ai/inference/go/openai/v1
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=cole-sua-chave-opencode-go-aqui

# Redação PT-BR (marketing digital): claude-haiku-5-5
# Por quê: melhor PT-BR criativo, rápido, barato ($0.10/M), 1M ctx, ZDR ok
# Alternativas: muse-spark-1.3-contributor (mais barato ainda, mas treina com dados) / gpt-6-luna (eficiente)
LLM_MODEL_REDACAO=claude-haiku-5-5
LLM_MODEL=mimo-v2.6-flash

# Transcrição áudio->texto: mimo-v2.6-flash
# Por quê: áudio nativo (mp3/wav/flac/ogg/mp4), 1M ctx p/ áudios longos, barato ($0.14/M), ZDR true, featured
# Alternativas: gemini-4-argon (melhor qualidade absoluta, mas 14x mais caro $2/M) / muse-spark-1.3-contributor (áudio ok, mas treina com dados)
LLM_MODEL_TRANSCRICAO=mimo-v2.6-flash

# Legado OpenAI (se quiser voltar)
OPENAI_API_KEY=

# Opcional p/ publicação
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
